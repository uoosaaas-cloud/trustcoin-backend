# --- Server ---
NODE_ENV=development
PORT=4000

# --- Database ---
# MySQL (current provider in prisma/schema.prisma). MAMP's default MySQL port is 8889.
DATABASE_URL="mysql://root:root@localhost:8889/trustcoin"
# Standalone MySQL install example:
# DATABASE_URL="mysql://user:password@localhost:3306/trustcoin"
# PostgreSQL example (switch provider = "postgresql" in prisma/schema.prisma to use this):
# DATABASE_URL="postgresql://user:password@localhost:5432/trustcoin?schema=public"

# --- Auth ---
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
BCRYPT_SALT_ROUNDS=12

# --- Internationalization ---
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,ar

# --- CORS ---
# Production: set to your frontend origin(s), comma-separated.
# Example: https://app.trustcoin.com
CORS_ORIGIN=*
# Set true when behind Nginx / Cloudflare / a load balancer.
TRUST_PROXY=false

# --- Frontend base URL (used to build shareable referral links) ---
APP_BASE_URL=http://localhost:3000
# Alias accepted by the backend (same as APP_BASE_URL):
# FRONTEND_URL=http://localhost:3000

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
# Dev/testing: 1000 / 15min. Production can lower this (e.g. 200).
RATE_LIMIT_MAX=1000

# --- OTP ---
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_EXPIRY_MINUTES=30

# --- Admin panel protection ---
ADMIN_MAX_FAILED_ATTEMPTS=5
# Bootstrap an ADMIN account (used by `npm run upsert-admin` / `src/scripts/upsert-admin.ts`):
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-strong-password
# There is no ADMIN_SECRET — access is JWT + User.role === ADMIN.

# --- Cron jobs ---
# Daily ROI distribution schedule (cron syntax). Default: every day at 00:00.
DAILY_ROI_CRON_SCHEDULE="0 0 * * *"

# --- Email (Resend — primary) ---
RESEND_API_KEY=
EMAIL_FROM="TrustCoin <onboarding@resend.dev>"
# Optional; defaults to ADMIN_EMAIL for new-withdrawal alerts.
ADMIN_ALERT_EMAIL=

# Legacy SMTP (unused when RESEND_API_KEY is set)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_PASSWORD=""
MAIL_FROM_NAME=TrustCoin
MAIL_FROM_ADDRESS=onboarding@resend.dev

# --- Deposits (platform receiving wallet addresses shown on the deposit page) ---
DEPOSIT_WALLET_TRC20="TMm1F9Qfitwc1nvEFWTzcNRRbS6ASfnCkT"
DEPOSIT_WALLET_BEP20="0x72b7cceb1dc99562c3509302d91e1325904b93f2"
DEPOSIT_WALLET_ERC20="0x9784eae8c0410a23c328967d73315700a19fae4a"
DEPOSIT_PROOF_MAX_FILE_SIZE_MB=5

# --- Deposit addresses (unique per-user, per-network HD-derived addresses) ---
# BIP-39 mnemonic used to deterministically derive every user's unique
# deposit address. The value below is the well-known public Hardhat/Ganache
# test mnemonic — fine for local dev only. Generate a real, secret mnemonic
# (e.g. `openssl rand -hex 32` fed through a BIP-39 tool, or any reputable
# wallet's "generate new wallet" flow) before ever accepting real deposits.
DEPOSIT_HD_MNEMONIC="test test test test test test test test test test test junk"
# 32-byte hex key (64 hex chars) used to encrypt derived private keys at
# rest. Generate your own with: openssl rand -hex 32
DEPOSIT_ADDRESS_ENCRYPTION_KEY="replace-with-your-own-32-byte-hex-key"

# --- Deposit sweep worker (auto-forward USDT → admin master wallet) ---
# Auto-sweep user sub-wallets → master (also runs ~2s after each deposit claim).
DEPOSIT_SWEEP_ENABLED=true
DEPOSIT_SWEEP_CRON_SCHEDULE="*/30 * * * * *"
DEPOSIT_SWEEP_MIN_USDT=1
DEPOSIT_SWEEP_MAX_RETRIES=5
DEPOSIT_SWEEP_LOCK_SECONDS=120
DEPOSIT_SWEEP_THROTTLE_MS=750
RPC_URL_BSC=https://bsc-dataseed.binance.org
RPC_URL_ETH=https://eth.llamarpc.com
# Primary Tron RPC (PublicNode is recommended to avoid TronGrid anonymous 429s).
TRON_FULL_HOST=https://tron-rpc.publicnode.com
TRON_FALLBACK_HOST=https://api.trongrid.io
# Any of these names work — used as TRON-PRO-API-KEY when talking to TronGrid.
TRON_GRID_API_KEY=""
# TRONGRID_API_KEY=""
# TRON_API_KEY=""

# --- Tron Energy Rental (Feee.io Fast-Trade — ENERGY only) ---
# Never use Feee for Bandwidth; Fast-Trade may charge Energy again and waste balance.
TRON_ENERGY_API_KEY=""
TRON_ENERGY_PROVIDER_URL=https://feee.io/open
TRON_ENERGY_REQUIRE=true
# Optional tuning:
# TRON_ENERGY_TIMEOUT_MS=15000
# TRON_ENERGY_CONFIRM_ATTEMPTS=8
# TRON_ENERGY_CONFIRM_DELAY_MS=1500

# --- Tron Bandwidth (auto TRX top-up + burn; reclaim leftover after sweep) ---
# Hex private key OR 12-word mnemonic (TronLink path m/44'/195'/0'/0/0).
TRON_BANDWIDTH_FUNDER_PRIVATE_KEY=""
# Preferred for mnemonics (or put 12 words in PRIVATE_KEY — auto-detected):
TRON_BANDWIDTH_FUNDER_MNEMONIC=""
# TRON_BANDWIDTH_FUNDER_DERIVATION_PATH=m/44'/195'/0'/0/0
TRON_BANDWIDTH_TRX_TOPUP=0.4
TRON_BANDWIDTH_MIN_TRX=0.35
TRON_BANDWIDTH_RECLAIM_MIN_TRX=0.2
# Prefer Feee; set true only as emergency (burns ~14 TRX).
TRON_ENERGY_TRX_BURN_FALLBACK=false
TRON_ENERGY_TRX_BURN_TOPUP=14
TRON_ENERGY_TRX_BURN_FEE_LIMIT_TRX=15

# EVM gas funder uses the same mnemonic as Tron funder on path m/44'/60'/0'/0/0
# (different address — fund it with BNB + ETH for BEP20/ERC20 sweeps).
EVM_GAS_TOPUP_BNB=0.0015
EVM_GAS_TOPUP_ETH=0.0008

USDT_CONTRACT_TRC20=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
USDT_CONTRACT_BEP20=0x55d398326f99059fF775485246999027B3197955
USDT_CONTRACT_ERC20=0xdAC17F958D2ee523a2206206994597C13D831ec7
